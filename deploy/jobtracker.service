[Unit]
Description=Job Tracker FastAPI App
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/job-tracker
EnvironmentFile=/root/job-tracker/.env
ExecStart=/root/job-tracker/job-tracker-venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
